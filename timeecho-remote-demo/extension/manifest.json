{
  "manifest_version": 3,
  "name": "TimeEcho Web Remote Bridge",
  "version": "1.1.0",
  "description": "让 TimeEcho 演示页遥控搜狐和 Bilibili 网页。",
  "permissions": [],
  "host_permissions": [
    "https://abouthewei.github.io/wnsf.github.io/timeecho-remote-demo/*",
    "https://www.bilibili.com/*",
    "https://player.bilibili.com/*",
    "https://*.sohu.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://abouthewei.github.io/wnsf.github.io/timeecho-remote-demo/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.bilibili.com/*", "https://player.bilibili.com/*", "https://*.sohu.com/*"],
      "js": ["site-bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
